{
	"name": "pi-background",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Background shell commands, subagents, a completion nudge and an activity signal for the pi coding agent.",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome check .",
		"test": "node --import ./test/bootstrap.ts --import tsx --test test/*.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "24.13.3",
		"tsx": "4.23.13",
		"typebox": "1.3.7",
		"typescript": "5.9.3"
	}
}
